{
  "manifest_version": 3,
  "name": "ScamX — Student Opportunity Scam Detector",
  "version": "1.0.0",
  "description": "Instant AI authenticity scanner for WhatsApp, LinkedIn, email, and social media job & internship offers.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "*://*/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ScamX Quick Scanner"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
